# 复制为 config/local.mk 后修改；local.mk 已被 Git 忽略。
# 使用绝对路径，不要给值加引号；?= 允许终端环境变量覆盖本机默认值。
# 被测版本的共享默认值在 config/offckb.toml；以下变量可作本机覆盖。
# OFFCKB_REF ?= latest
# 测试开发分支时改为 develop。
# OFFCKB_REPO ?= https://github.com/ckb-devrel/offckb.git

CKB_BIN ?= /absolute/path/to/ckb

# latest 不需要源码；源码模式查找 source/offckb/、../offckb/，其他位置才需设置。
# OFFCKB_SOURCE ?= /absolute/path/to/offckb

# 存在多个 pnpm 时固定 pnpm 10 的绝对路径，避免不同终端选择不同版本。
# PNPM_BIN ?= /absolute/path/to/pnpm
